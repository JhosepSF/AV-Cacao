{
    "app": "AV-Cacao",
    "pipeline_version": "2.5_V3_EXIF_VERTICAL_FINAL",
    "pipeline_sha256": "2a66bdf498512d3656a6679b14eb2b1e509c9ed495978eafd727d13a3a41bacb",
    "input_source": "camera_or_gallery_rgb_image",
    "exif": {
        "apply_orientation_before_segmentation": true,
        "reference_behavior": "equivalent_to_Pillow_ImageOps_exif_transpose"
    },
    "segmenter": {
        "file": "cacao_yolo26n_seg.onnx",
        "format": "onnx",
        "task": "instance_segmentation",
        "class_count": 1,
        "class_order": [
            "cacao"
        ],
        "input_layout": "NCHW",
        "input_dtype": "float32",
        "input_range": [
            0.0,
            1.0
        ],
        "channel_order": "RGB",
        "dynamic_spatial_shape": true,
        "primary_imgsz": 640,
        "fallback_imgsz": 1024,
        "confidence_threshold": 0.05,
        "nms_iou_threshold": 0.7,
        "ultra_low_conf_retry": false,
        "selection": {
            "score_formula": "0.50*confidence + 0.30*area_score + 0.20*centrality",
            "weight_confidence": 0.5,
            "weight_area": 0.3,
            "weight_centrality": 0.2,
            "area_score_formula": "min(area_relative / 0.40, 1.0)",
            "centrality_formula": "1 - normalized_centroid_distance_clipped_to_1"
        }
    },
    "geometry": {
        "normalize_to_vertical": true,
        "principal_axis_method": "PCA_on_binary_mask_pixels",
        "target_axis_angle_deg": 90.0,
        "max_vertical_deviation_deg": 5.0,
        "rotate_rgb_and_mask_with_same_affine_matrix": true,
        "background_rgb": [
            255,
            255,
            255
        ],
        "crop_margin_fraction": 0.08,
        "square_padding": true,
        "master_output_size": 1024,
        "master_output_size_shape": [
            1024,
            1024,
            3
        ]
    },
    "classifier": {
        "file": "resnet18_cacao.onnx",
        "architecture": "ResNet18",
        "format": "onnx",
        "input_shape": [
            1,
            3,
            224,
            224
        ],
        "input_layout": "NCHW",
        "input_dtype": "float32",
        "channel_order": "RGB",
        "preprocessing": {
            "resize_shorter_side": 256,
            "center_crop": 224,
            "interpolation": "bilinear",
            "antialias": true,
            "scale_to_0_1": true,
            "mean": [
                0.485,
                0.456,
                0.406
            ],
            "std": [
                0.229,
                0.224,
                0.225
            ]
        },
        "output": {
            "type": "logits",
            "shape": [
                1,
                4
            ],
            "postprocess": "softmax",
            "class_order": [
                "Fitoptora",
                "Sana",
                "Plaga_Chinche",
                "Monilia"
            ]
        }
    },
    "production_failure_policy": {
        "if_no_reliable_segmentation": "reject_and_request_new_image",
        "manual_rescue_in_mobile_app": false,
        "force_classification_without_segmentation": false
    }
}